{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/Dockerfile.ci",
      "{workspaceRoot}/.dockerignore",
      { "runtime": "node --version" },
      "{workspaceRoot}/scripts/assert-staging-only.mjs",
      "{workspaceRoot}/scripts/assert-production.mjs",
      "{workspaceRoot}/scripts/docker-start.sh",
      "{workspaceRoot}/scripts/docker-start-ci.sh"
    ],
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.{spec,test}.{js,jsx,ts,tsx,mjs,cjs}",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/coverage/**"
    ],
    "dappBuildEnv": [
      { "env": "CUKIES_DEPLOYMENT_ID" },
      { "env": "CUKIES_BUILD_ENV_HASH" },
      { "env": "CUKIES_STANDALONE" },
      { "env": "NEXT_PUBLIC_APP_ENV" },
      { "env": "NEXT_PUBLIC_UKI_CHAIN_ID" },
      { "env": "NEXT_PUBLIC_ASM_TOKEN_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_TOKEN_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_VESTING_VAULT_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_PRESALE_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_STAKING_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_REWARDS_DISTRIBUTOR_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_MARKETPLACE_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_MARKETPLACE_ROUTER_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_MARKETPLACE_WBNB_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_MARKETPLACE_USDT_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_MARKETPLACE_BNB_PATH" },
      { "env": "NEXT_PUBLIC_UKI_MARKETPLACE_USDT_PATH" },
      { "env": "NEXT_PUBLIC_UKI_LIQUIDITY_PAIR_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_LIQUIDITY_LOCKER_ADDRESS" },
      { "env": "NEXT_PUBLIC_UKI_LIQUIDITY_UNLOCK_LABEL" },
      { "env": "NEXT_PUBLIC_UKI_SWAP_URL" },
      { "env": "NEXT_PUBLIC_CUKIE_MASTER_NFT_VAULT_ADDRESS" },
      { "env": "NEXT_PUBLIC_CUKIE_POOL_NFT_VAULT_ADDRESS" },
      { "env": "NEXT_PUBLIC_CUKIES_NFT_COLLECTION_ADDRESS" },
      { "env": "NEXT_PUBLIC_CUKIES_NFT_COLLECTION_ADDRESSES" },
      { "env": "NEXT_PUBLIC_CUKIES_NFT_RECOVERY_COLLECTION_ADDRESSES" },
      { "env": "NEXT_PUBLIC_CUKIE_POOL_RECOVERY_VAULT_ADDRESSES" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_MODE" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_BSC_CHAIN_ID" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_BSC_COLLECTION_ADDRESS" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_BSC_ENDPOINT_ADDRESS" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_TRON_NETWORK" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_TRON_RPC_URL" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_TRON_COLLECTION_ADDRESS" },
      { "env": "NEXT_PUBLIC_CUKIES_BRIDGE_TRON_ENDPOINT_ADDRESS" },
      { "env": "NEXT_PUBLIC_BSCSCAN_BASE_URL" },
      { "env": "NEXT_PUBLIC_UKI_PRESALE_START_ISO" },
      { "env": "NEXT_PUBLIC_UKI_PRESALE_START_LABEL" },
      { "env": "NEXT_PUBLIC_UKI_PRESALE_START_SHORT_LABEL" },
      { "env": "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID" },
      { "env": "NEXT_PUBLIC_AMBASSADORS_VISIBLE" },
      { "env": "NEXT_PUBLIC_APP_URL" },
      { "env": "NEXT_PUBLIC_GAME_COMMUNICATION_KEY" },
      { "env": "NEXT_PUBLIC_GAME_HYPPIE_ROAD" },
      { "env": "NEXT_PUBLIC_GAME_TOWER_BUILDER" },
      { "env": "NEXT_PUBLIC_GAME_SYBILSLASH" },
      { "env": "NEXT_PUBLIC_PUSHER_KEY" },
      { "env": "NEXT_PUBLIC_PUSHER_CLUSTER" },
      { "env": "NEXT_PUBLIC_TWITTER_PROFILE_URL" },
      { "env": "NEXT_PUBLIC_DISCORD_INVITE_URL" },
      { "env": "NEXT_PUBLIC_DISCORD_CLIENT_ID" },
      { "env": "NEXT_PUBLIC_TWITTER_CLIENT_ID" },
      { "env": "DISCORD_CLIENT_ID" },
      { "env": "TWITTER_CLIENT_ID" },
      { "env": "GAME_SYBILSLASH" },
      { "env": "GAME_HYPPIE_ROAD" },
      { "env": "GAME_TOWER_BUILDER" }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.next"]
    }
  }
}
