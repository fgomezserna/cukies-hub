{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter dapp --filter sybil-slayer --filter hyppie-road --filter tower-builder dev",
    "dev:dapp": "pnpm --filter dapp dev",
    "dev:sybil-slayer": "pnpm --filter sybil-slayer dev",
    "dev:hyppie-road": "pnpm --filter hyppie-road dev",
    "dev:tower-builder": "pnpm --filter tower-builder dev",
    "genkit:dev": "pnpm --filter dapp genkit:dev",
    "genkit:watch": "pnpm --filter dapp genkit:watch",
    "dapp": "pnpm --filter dapp",
    "sybil-slayer": "pnpm --filter sybil-slayer",
    "hyppie-road": "pnpm --filter hyppie-road",
    "tower-builder": "pnpm --filter tower-builder",
    "contracts": "pnpm --filter @cukies/contracts",
    "chain-indexer": "pnpm --filter @cukies/chain-indexer",
    "card-worker": "pnpm --filter @cukies/cuki-card-worker",
    "guard:staging": "node scripts/assert-staging-only.mjs",
    "guard:staging:test": "node --test scripts/assert-staging-only.test.mjs",
    "staging:indexer:setup": "node scripts/assert-staging-only.mjs --scope chain-indexer && pnpm indexer:setup",
    "staging:economy:setup": "node scripts/assert-staging-only.mjs --scope chain-indexer && pnpm indexer:setup:economy",
    "staging:economy:setup:prod": "node scripts/assert-staging-only.mjs --scope chain-indexer && pnpm --filter @cukies/chain-indexer run setup:economy:prod",
    "staging:economy:migrate:v2:prod": "node scripts/assert-staging-only.mjs --scope chain-indexer && pnpm --filter @cukies/chain-indexer run migrate:economy:v2:prod",
    "staging:economy:rules:plan": "node scripts/assert-staging-only.mjs --scope dapp && node dapp/scripts/bootstrap-staging-economy-rules.mjs --plan",
    "staging:economy:rules:apply": "node scripts/assert-staging-only.mjs --scope dapp && node dapp/scripts/bootstrap-staging-economy-rules.mjs --apply --confirm APPLY_STAGING_TESTNET_97_RULES_V1",
    "staging:economy:rules:test": "node --test dapp/scripts/staging-economy-rules-policy.test.mjs",
    "staging:cards:setup": "node scripts/assert-staging-only.mjs --scope cuki-card-worker && pnpm cards:setup",
    "indexer:dev": "pnpm --filter @cukies/chain-indexer run dev",
    "indexer:setup": "pnpm --filter @cukies/chain-indexer run setup",
    "indexer:setup:economy": "pnpm --filter @cukies/chain-indexer run setup:economy",
    "indexer:migrate:economy:v2": "pnpm --filter @cukies/chain-indexer run migrate:economy:v2",
    "indexer:status": "pnpm --filter @cukies/chain-indexer run status",
    "indexer:ingest": "pnpm --filter @cukies/chain-indexer run ingest:once",
    "indexer:import:legacy": "pnpm --filter @cukies/chain-indexer run import:legacy",
    "indexer:import:metadata": "pnpm --filter @cukies/chain-indexer run import:legacy-metadata",
    "indexer:project": "pnpm --filter @cukies/chain-indexer run project:once",
    "build:indexer": "pnpm --filter @cukies/chain-indexer run build",
    "start:indexer": "pnpm --filter @cukies/chain-indexer run start",
    "cards:dev": "pnpm --filter @cukies/cuki-card-worker run dev",
    "cards:setup": "pnpm --filter @cukies/cuki-card-worker run setup",
    "cards:status": "pnpm --filter @cukies/cuki-card-worker run status",
    "cards:process": "pnpm --filter @cukies/cuki-card-worker run process:once",
    "cards:render": "pnpm --filter @cukies/cuki-card-worker run render",
    "cards:generate": "pnpm --filter @cukies/cuki-card-worker run generate",
    "test:cards": "pnpm --filter @cukies/cuki-card-worker run test",
    "build:cards": "pnpm --filter @cukies/cuki-card-worker run build",
    "start:cards": "pnpm --filter @cukies/cuki-card-worker run start",
    "build:dapp": "pnpm --filter dapp build",
    "build:sybil-slayer": "pnpm --filter sybil-slayer build",
    "build:hyppie-road": "pnpm --filter hyppie-road build",
    "build:tower-builder": "pnpm --filter tower-builder build"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
