{
  "name": "@cukies/cukies-bridge-relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx src/cli.ts run",
    "run": "tsx src/cli.ts run",
    "run:once": "tsx src/cli.ts run-once",
    "setup": "tsx src/cli.ts setup",
    "setup:prod": "node dist/cli.js setup",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js run",
    "start:once": "node dist/cli.js run-once",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "mongodb": "^7.0.0",
    "tronweb": "^6.1.0",
    "viem": "^2.31.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.6",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
