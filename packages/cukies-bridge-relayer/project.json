{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cukies-bridge-relayer",
  "projectType": "library",
  "sourceRoot": "packages/cukies-bridge-relayer/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm exec tsc -p tsconfig.json",
        "cwd": "packages/cukies-bridge-relayer"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit",
        "cwd": "packages/cukies-bridge-relayer"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec node --import tsx --test src/*.test.ts",
        "cwd": "packages/cukies-bridge-relayer"
      }
    }
  },
  "tags": ["scope:cukies-bridge-relayer"]
}
