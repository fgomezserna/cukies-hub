{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "game-bridge",
  "projectType": "library",
  "sourceRoot": "packages/game-bridge/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "node -e \"require('node:fs').accessSync('packages/game-bridge/src/index.ts')\"",
